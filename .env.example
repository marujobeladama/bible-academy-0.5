NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Mercado Pago Checkout Pro. Keep both values server-side and out of source control.
PAYMENT_GATEWAY_PROVIDER=mercadopago
MERCADOPAGO_ACCESS_TOKEN=
MERCADOPAGO_WEBHOOK_SECRET=

# Optional distributed rate limiting via Upstash Redis (REST API, no SDK).
# Without these, rate limiting falls back to in-memory per-instance
# counting automatically — fine for local dev, not for multi-instance
# production. Get the URL/token from the Upstash console (REST API tab of
# your Redis database). Set RATE_LIMIT_PROVIDER exactly to "upstash-redis"
# to activate it; any other value (or leaving it blank) keeps in-memory.
RATE_LIMIT_PROVIDER=
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Optional OpenTelemetry OTLP collector (Sentry, Datadog, New Relic, etc.).
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_EXPORTER_OTLP_HEADERS=