{
  "name": "bible-academy",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:unit": "vitest run tests/unit",
    "test:integration": "vitest run tests/integration",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:mutation": "stryker run",
    "test:ci": "npm run test:coverage && npm run test:integration",
    "format:check": "biome check --formatter-enabled=true --linter-enabled=false --assist-enabled=false tests/unit tests/integration",
    "biome:check": "biome lint tests/unit tests/integration",
    "arch:check": "arch-contract check",
    "knip": "knip",
    "prepare": "husky"
  },
  "dependencies": {
    "@supabase/ssr": "0.12.7",
    "@supabase/supabase-js": "2.114.0",
    "@vercel/otel": "^2.1.3",
    "mercadopago": "^3.6.1",
    "next": "16.3.6",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "0.0.1",
    "tus-js-client": "4.3.1",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.14",
    "@commitlint/cli": "^21.2.3",
    "@commitlint/config-conventional": "^21.2.3",
    "@playwright/test": "^1.63.0",
    "@stryker-mutator/core": "^10.0.0",
    "@stryker-mutator/vitest-runner": "^10.0.0",
    "@types/node": "24.3.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitest/coverage-v8": "^5.0.2",
    "arch-contract": "^0.3.0",
    "eslint": "9.35.0",
    "eslint-config-next": "16.3.6",
    "husky": "^9.1.7",
    "knip": "^6.38.0",
    "typescript": "5.9.2",
    "vitest": "^5.0.2"
  }
}
